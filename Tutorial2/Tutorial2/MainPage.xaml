<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tutorial2.MainPage"
             Title="Pet Profile"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">


    <VerticalStackLayout Spacing="0">

        <Label Text="Your Name and ID here"
               HorizontalOptions="Center"
               TextColor="#444"
               Margin="0,15"/>

        <Image 
            Source="pug_image.png"  Aspect="AspectFill"
            HeightRequest="300"
            HorizontalOptions="Fill" />

        <Border StrokeThickness="0"
                BackgroundColor="#FFF9E8"
                Padding="20"
                Margin="15,-50,15,0" 
                ZIndex="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto, Auto, Auto"
                  ColumnDefinitions="*, Auto"
                  RowSpacing="8">

                <Label Grid.Row="0" Grid.Column="0"
                       Text="Robin Hood"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="Black"/>
                <Label Grid.Row="0" Grid.Column="1"
                       Text="♂" 
                       FontSize="24"
                       TextColor="Black"
                       VerticalOptions="Center"/>

                <Label Grid.Row="1" Grid.Column="0"
                       Text="Pug"
                       FontSize="16"
                       TextColor="Gray"/>
                <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="5" VerticalOptions="Center">
                    <Label Text="🕒" FontSize="14"/>
                    <Label Text="1 year old" FontSize="14" TextColor="Gray"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="5" Margin="0,5,0,0">
                    <Label Text="📍" FontSize="14"/>
                    <Label Text="3B, Lorong 88, Taman Rantau Panjang, 96000 Sibu, Sarawak"
                           FontSize="14"
                           TextColor="Gray"
                           LineBreakMode="WordWrap"/>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <VerticalStackLayout Padding="25" Spacing="15">
            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                <Image 
                    Grid.Column="0"
                    Source="owner_avatar.png" HeightRequest="50"
                    WidthRequest="50"
                    Aspect="AspectFill">
                    <Image.Clip>
                        <EllipseGeometry Center="25,25" RadiusX="25" RadiusY="25" />
                    </Image.Clip>
                </Image>

                <VerticalStackLayout Grid.Column="1" Padding="15,0" VerticalOptions="Center">
                    <Label Text="Jeon Jungkook"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="Black"/>
                    <Label Text="Owner"
                           FontSize="14"
                           TextColor="Gray"/>
                </VerticalStackLayout>

                <Label Grid.Column="2"
                       Text="1.11.2024"
                       FontSize="12"
                       TextColor="Gray"
                       VerticalOptions="Start"/>
            </Grid>

            <Label Text="Hi! Robin the Pug is simply a tiny tornado of fur, wrinkles, and endless charm!"
                   FontSize="15"
                   TextColor="#333"
                   LineHeight="1.3"/>

        </VerticalStackLayout>

        <BoxView VerticalOptions="FillAndExpand" />

        <HorizontalStackLayout Spacing="10" Padding="25, 10, 25, 20">
            <Button Text="♡" 
                    FontSize="20"
                    BorderColor="LightGray"
                    BorderWidth="1"
                    BackgroundColor="White"
                    TextColor="Gray"
                    WidthRequest="60"
                    HeightRequest="60"
                    CornerRadius="30"/>

            <Button Text="Adoption"
                    FontAttributes="Bold"
                    FontSize="18"
                    BackgroundColor="#FFD15B"
                    TextColor="Black"
                    HorizontalOptions="FillAndExpand"
                    HeightRequest="60"
                    CornerRadius="30"/>
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>